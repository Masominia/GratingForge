# Emission angle for a given period.
# Reference: the grating equation with the mean index of the two sections.
title Standard grating with a 600 nm period
grating period=0.6 length=20
expect period 0.60000000 1e-07
expect angle 4.37812411 1e-05
expect orders 1
expect second_order 1.61613954 1e-06
expect dtheta_dlambda -0.09002428 0.001

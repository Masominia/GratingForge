# The leakage that suits one mode size is wrong for another.
# Reference: closed form with error functions.
title Fibre with a 14 um mode field diameter
grating angle=10 length=30
leak 0.14
fibre mfd=14.0
sweep 1.42 1.68 261
expect radiated 0.98500442 1e-06
expect overlap 0.79205970 2e-05
expect efficiency 0.39009116 2e-05
expect position 5.97582376 0.005
expect peak_wavelength 1.55000000 0.0002
expect bandwidth_1db 28.48962385 0.004
expect bandwidth_3db 49.58580408 0.004

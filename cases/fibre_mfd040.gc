# The leakage that suits one mode size is wrong for another.
# Reference: closed form with error functions.
title Fibre with a 4 um mode field diameter
grating angle=10 length=30
leak 0.14
fibre mfd=4.0
sweep 1.42 1.68 261
expect radiated 0.98500442 1e-06
expect overlap 0.46457019 2e-05
expect efficiency 0.22880185 2e-05
expect position 2.56881328 0.005
expect peak_wavelength 1.55000000 0.0002
expect bandwidth_1db 83.76102719 0.004
expect bandwidth_3db 144.89776414 0.004

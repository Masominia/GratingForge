# Overlap of an exponentially decaying field with the Gaussian fibre mode.
# Reference: closed form with error functions.
title Uniform grating, leakage 0.6 per um
grating angle=10 length=40
leak 0.6
expect radiated 1.00000000 1e-06
expect overlap 0.66121991 2e-05
expect efficiency 0.33060996 2e-05
expect position 2.42266521 0.005
expect efficiency_db -4.80684 0.0005

# Coupling against fibre position along the grating.
# Reference: closed form with error functions.
title Fibre fixed 8 um from the start of the grating
grating angle=10 length=30
leak 0.14
fibre position=8.0
expect overlap 0.61838926 2e-05
expect efficiency 0.30455808 2e-05
expect efficiency_db -5.16330 0.0005

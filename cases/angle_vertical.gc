# Vertical emission: the period equals the wavelength in the grating, and the second order reflects.
# Reference: n_grating - lambda / period = n_clad sin(angle).
title Standard grating designed for 0 degrees
grating angle=0.0 length=20
expect period 0.57544536 1e-07
expect angle 0.00000000 1e-05
expect orders 1
expect second_order 1.55000000 1e-06
expect dtheta_dlambda -0.09261978 0.001

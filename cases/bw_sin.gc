# Low index contrast means a low group index and a wide band.
# Reference: numerical spectrum in NumPy.
title Silicon nitride grating: bandwidth
stack core=0.4
materials core=sin
grating angle=10 etch=0.2 length=45
leak 1.5
apodise gaussian
sweep 1.35 1.75 401
expect peak_wavelength 1.55000001 0.0002
expect bandwidth_1db 83.88402752 0.004
expect bandwidth_3db 145.80793623 0.004
expect group_index 1.91245568 0.0002

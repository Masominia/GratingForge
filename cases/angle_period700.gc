# Emission angle for a given period.
# Reference: the grating equation with the mean index of the two sections.
title Standard grating with a 700 nm period
grating period=0.7 length=20
expect period 0.70000000 1e-07
expect angle 19.38483597 1e-05
expect orders 1
expect second_order 1.88549613 1e-06
expect dtheta_dlambda -0.08501191 0.001

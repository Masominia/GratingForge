# Period from the grating equation for the requested emission angle in the cladding.
# Reference: n_grating - lambda / period = n_clad sin(angle).
title Standard grating designed for 8 degrees
grating angle=8 length=20
expect period 0.62184066 1e-07
expect angle 8.00000000 1e-05
expect orders 1
expect second_order 1.67496880 1e-06
expect dtheta_dlambda -0.08826800 0.001

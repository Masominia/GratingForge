# The leakage that suits one mode size is wrong for another.
# Reference: closed form with error functions.
title Fibre with a 9.2 um mode field diameter
grating angle=10 length=30
leak 0.14
fibre mfd=9.2
sweep 1.42 1.68 261
expect radiated 0.98500442 1e-06
expect overlap 0.70957478 2e-05
expect efficiency 0.34946715 2e-05
expect position 4.60445232 0.005
expect peak_wavelength 1.55000000 0.0002
expect bandwidth_1db 40.09448401 0.004
expect bandwidth_3db 69.49341910 0.004

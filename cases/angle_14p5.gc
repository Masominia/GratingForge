# Period from the grating equation for the requested emission angle in the cladding.
# Reference: n_grating - lambda / period = n_clad sin(angle).
title Standard grating designed for 14.5 degrees
grating angle=14.5 length=20
expect period 0.66466063 1e-07
expect angle 14.50000000 1e-05
expect orders 1
expect second_order 1.79030720 1e-06
expect dtheta_dlambda -0.08598406 0.001

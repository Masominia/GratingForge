# Coupling against fibre position along the grating.
# Reference: closed form with error functions.
title Fibre fixed 0 um from the start of the grating
grating angle=10 length=30
leak 0.14
fibre position=0.0
expect overlap 0.31730577 2e-05
expect efficiency 0.15627380 2e-05
expect efficiency_db -8.06114 0.0005

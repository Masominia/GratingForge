# A deeper etch lowers the mean index and tilts the beam backward.
# Reference: the grating equation.
title Etch depth 110 nm at a fixed 630 nm period
grating period=0.63 etch=0.11 length=20
expect n_etched 2.26972131 2e-07
expect n_grating 2.55875178 2e-07
expect period 0.63000000 1e-07
expect angle 3.90875895 1e-05
expect orders 1
expect second_order 1.61201362 1e-06
expect dtheta_dlambda -0.08656951 0.001

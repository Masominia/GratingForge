# Backward emission: a longer period sends the first order behind the normal.
# Reference: n_grating - lambda / period = n_clad sin(angle).
title Standard grating designed for -12 degrees
grating angle=-12 length=20
expect period 0.51773832 1e-07
expect angle -12.00000000 1e-05
expect orders 1
expect second_order 1.39456228 1e-06
expect dtheta_dlambda -0.10264733 0.001

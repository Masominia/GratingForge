# The same recipe at another wavelength; far from 1.55 um the indices are given as numbers.
# Reference: independent slab solve, overlap and spectrum.
title 10 degree grating at 1.625 um
wavelength 1.625
materials core=si
grating angle=10 length=20
fibre mfd=10.4
sweep 1.565 1.685 241
expect n_full 2.80634756 2e-07
expect period 0.67740491 1e-07
expect radiated 0.93918994 1e-06
expect overlap 0.77481992 2e-05
expect efficiency 0.36385154 2e-05
expect position 4.98154717 0.005
expect peak_wavelength 1.62500000 0.0002
expect bandwidth_1db 40.10415870 0.004
expect bandwidth_3db 69.57410770 0.004

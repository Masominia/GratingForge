# A tilt error is a phase-matching error at the design wavelength: the peak moves to another wavelength.
# Reference: closed form with complex error functions.
title Fibre tilted +2 degrees from the emission angle
grating angle=10 length=30
leak 0.14
fibre angle=12
sweep 1.45 1.65 401
expect radiated 0.98500442 1e-06
expect overlap 0.52200027 2e-05
expect efficiency 0.25708629 2e-05
expect position 4.16007196 0.005
expect peak_wavelength 1.52722580 0.0002
expect bandwidth_1db 37.39557850 0.004
expect bandwidth_3db 65.08896858 0.004

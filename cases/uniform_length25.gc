# A short grating does not radiate everything: 1 - exp(-leakage x length).
# Reference: closed form.
title Uniform grating 25 um long
grating angle=10 length=25
leak 0.14
expect radiated 0.96980262 1e-06
expect overlap 0.75037810 2e-05
expect efficiency 0.36385932 2e-05
expect position 4.98203191 0.005
expect radiated 0.96980262 1e-6

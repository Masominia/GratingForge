# The TM mode needs a longer period.
# Reference: independent slab solve, overlap and spectrum.
title 220 nm silicon, TM, 10 degrees
polarisation tm
grating angle=10 etch=0.07 length=30
leak 0.12
sweep 1.45 1.65 401
expect n_full 2.05331968 2e-07
expect n_etched 1.61411541 2e-07
expect n_grating 1.83371754 2e-07
expect period 0.97917233 1e-07
expect angle 10.00000000 1e-05
expect orders 2
expect second_order 1.79552547 1e-06
expect dtheta_dlambda -0.07363828 0.001
expect radiated 0.97267628 1e-06
expect overlap 0.71040924 2e-05
expect efficiency 0.34549911 2e-05
expect position 5.26225770 0.005
expect peak_wavelength 1.55000000 0.0002
expect bandwidth_1db 41.93156628 0.004
expect bandwidth_3db 72.72640418 0.004

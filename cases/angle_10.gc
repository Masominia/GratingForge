# Period from the grating equation for the requested emission angle in the cladding.
# Reference: n_grating - lambda / period = n_clad sin(angle).
title Standard grating designed for 10 degrees
grating angle=10 length=20
expect period 0.63451311 1e-07
expect angle 10.00000000 1e-05
expect orders 1
expect second_order 1.70910287 1e-06
expect dtheta_dlambda -0.08744670 0.001

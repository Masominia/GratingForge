# A deeper etch lowers the mean index and tilts the beam backward.
# Reference: the grating equation.
title Etch depth 40 nm at a fixed 630 nm period
grating period=0.63 etch=0.04 length=20
expect n_etched 2.69257284 2e-07
expect n_grating 2.77017754 2e-07
expect period 0.63000000 1e-07
expect angle 12.39115449 1e-05
expect orders 1
expect second_order 1.74521185 1e-06
expect dtheta_dlambda -0.08805848 0.001
